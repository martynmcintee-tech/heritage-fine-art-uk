# Prodigi API Settings (Get sandbox or live key from dashboard.prodigi.com)
PRODIGI_API_KEY=your_prodigi_api_key_here
PRODIGI_ENVIRONMENT=sandbox # Set to 'live' for production

# Shopify Store Settings
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Configuration
PORT=3000
RETURNLESS_REFUND_SECRET=secret_token_for_returns_webhook

# Zero-Outlay Direct Stripe Storefront (Get from dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
